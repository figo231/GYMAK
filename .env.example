# Copy this file to .env and fill in real values from your Supabase project
# settings (Project Settings -> API). The app runs fully offline/local-only
# without these — they're only needed to enable account sign-in and cloud
# sync (see src/lib/supabaseClient.js).

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project's public "anon" key (safe to expose in a client
# app — it has no privileges beyond what Row Level Security policies in
# supabase/migrations/ allow for an authenticated or anonymous user).
# Never put the "service_role" key here or anywhere in this project.
VITE_SUPABASE_ANON_KEY=
